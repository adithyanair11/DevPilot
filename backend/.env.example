# Copy to .env and fill in real values.

# Database (matches docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=postgres

# OpenAI
OPENAI_API_KEY=sk-...

# GitHub OAuth app
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# Encryption for stored GitHub tokens.
# Changing these makes already-stored tokens unreadable (users must sign in again).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTOR_PASSWORD=change-me
# Must be hex. Generate with: openssl rand -hex 8
TOKEN_ENCRYPTOR_SALT=change-me-hex

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
