# ============================================================
# DevPilot — root .gitignore
# (client/ and backend/ also have their own .gitignore files)
# ============================================================

# ---------- Secrets & environment ----------
.env
.env.*
!.env.example
backend/.env
client/.env*
!client/.env.example
*.pem
*.key
*.p12
*.jks
application-local.properties
application-*.local.properties

# ---------- OS files ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

# ---------- Node / Next.js (client) ----------
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Java / Maven (backend) ----------
target/
.mvn/wrapper/maven-wrapper.jar
*.class
hs_err_pid*
replay_pid*

# ---------- Logs & temp ----------
logs/
*.log
tmp/
*.tmp

# ---------- Local AI assistant output ----------
Claude outputs/
